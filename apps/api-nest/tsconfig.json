{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node",
      "jest"
    ],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    // `@sentry/core` publishes its server half as a subpath export, which
    // "moduleResolution": "node" does not read. Node itself does: this is for
    // the type checker alone, and nothing is rewritten in what is emitted.
    "paths": {
      "@sentry/core/server": [
        "./node_modules/@sentry/core/build/types/server"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
