# When another proxy sits in front (a Cloudflare tunnel, a Webuzo vhost), the
# browser's scheme is https but ours is http, so $scheme would tell the API the
# request was insecure. With SECURE_SSL_REDIRECT on that is an infinite redirect
# loop. Prefer the upstream proxy's value and fall back to our own.
# Everything arrives through Docker's NAT, so the source IP is the bridge
# gateway whether it came from this laptop, the LAN, or the public tunnel — IP
# rules cannot tell them apart. The Host header can.
# Nothing below uses this since the Django admin was dropped (ADR-0020); it is
# kept as the guard to put on /admin and /pos for a shop that only uses them
# on-site (docs/operations/self-hosting-with-a-domain.md, section 4).
map $host $via_public_tunnel {
    default                              0;
    "~^(www\.)?rangonfashion\.com$"       1;
    "~\.trycloudflare\.com$"              1;
}

map $http_x_forwarded_proto $client_proto {
    default            $scheme;
    "~^https?$"        $http_x_forwarded_proto;
}

# Local production routing — one origin, exactly like the deployed topology,
# minus TLS.
#
# This mirrors templates/default.conf.template but is a separate file on purpose:
#   * no domain and no certificate paths
#   * no TLS block and no HSTS, because this listens on plain HTTP on localhost.
#     HSTS on localhost would poison every other localhost project in your
#     browser, which is a genuinely annoying thing to undo.
#
# The http{} level — gzip, rate-limit zones, proxy headers, JSON access log —
# comes from the real ../nginx.conf, which is mounted alongside this.
#
# A template, rendered at container start (the image runs `envsubst` over
# /etc/nginx/templates/*.template into conf.d/), for one variable:
# RANGON_API_UPSTREAM, which API serves. `NGINX_ENVSUBST_FILTER=RANGON_` in the
# compose file keeps every `$nginx_variable` below as it is written. It was a
# plain conf.d file until the cutover (ADR-0017) gave it something to vary.

# The API: `api-nest:3000`, set by the compose file. A variable since the
# cutover (ADR-0017), when two APIs could serve; one has since Django went.
upstream rangon_api { server ${RANGON_API_UPSTREAM}; keepalive 32; }
upstream rangon_web { server web:3000; keepalive 32; }

server {
    listen 80;
    server_name localhost;

    location /healthz { access_log off; return 200 "ok\n"; }

    # nginx only inherits proxy_set_header from http{} when the current level
    # declares none. Overriding X-Forwarded-Proto therefore means restating the
    # whole set from nginx.conf, or Host and X-Real-IP would silently vanish.
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $client_proto;
    proxy_set_header X-Request-ID      $request_id;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        "upgrade";

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options        "DENY" always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy     "camera=(), microphone=(), geolocation=(), payment=()" always;
    # Content-Security-Policy is NOT set here.
    #
    # It used to be, with 'unsafe-inline' in script-src as a stopgap: under the
    # strict `script-src 'self'` this file originally carried, the app rendered
    # a BLANK PAGE, because the Next.js App Router streams its RSC payload
    # through inline <script>self.__next_f.push(...)</script> tags and the
    # browser blocked every one of them.
    #
    # The web app now mints a per-request nonce in `apps/web/src/middleware.ts`
    # and sends the policy itself, so scripts are nonced and 'unsafe-inline' is
    # gone. Do not add the header back: `add_header` appends rather than
    # replaces, and a browser enforces the intersection of every policy it is
    # sent, so a second header here would block the nonced scripts and restore
    # the blank page. D16 in docs/roadmap.md.

    # --- Next.js owns part of /api/ -----------------------------------------
    #
    # These two prefixes are NOT the API. `/api/proxy/*` is the route handler
    # that attaches the httpOnly access token to browser calls (ADR-0005), and
    # `/api/auth/*` is where login/logout set those cookies. Every interactive
    # thing in the app goes through them: cart, checkout, POS sales, admin
    # actions, signing in.
    #
    # The shipped conf.d/rangon.conf sends all of /api/ to the API, so under it
    # each of those returns 404 and the app looks completely dead while the
    # pages themselves still render. Verified here by clicking "Add to cart" and
    # watching /api/proxy/shop/cart 404. Longest-prefix wins in nginx, so these
    # must simply exist — order in the file does not matter.
    location /api/proxy/ {
        proxy_pass http://rangon_web;
        proxy_read_timeout 60s;
    }

    location /api/auth/ {
        limit_req zone=auth burst=5 nodelay;
        proxy_pass http://rangon_web;
    }

    # --- The API ------------------------------------------------------------
    location /api/ {
        limit_req zone=general burst=60 nodelay;
        proxy_pass http://rangon_api;
        proxy_read_timeout 60s;
    }

    location ~ ^/api/v1/auth/(login|register|password) {
        limit_req zone=auth burst=5 nodelay;
        proxy_pass http://rangon_api;
    }

    # --- What Django alone served --------------------------------------------
    # The Django admin, the OpenAPI schema and its Swagger page were dropped,
    # not replaced (ADR-0020, decision 2), and Django has since gone. Still
    # refused here, plainly, for an old bookmark or a scanner.
    location ~ ^/(django-admin|api/schema|api/docs)(/|$) {
        return 404;
    }

    # Receipts are staff-only: they are served by
    # GET /api/v1/expenses/{id}/attachment/, which checks who is asking.
    # The API refuses this prefix on /media/ as well (media/media.ts, D91); this is the second lock, and it keeps holding if /media/ is ever
    # switched to an `alias` for speed. Longest-prefix `^~` wins over /media/.
    location ^~ /media/expenses/ {
        return 404;
    }

    # Uploaded product photography. The API owns these bytes (USE_S3=0 keeps them
    # on its disk, a volume); the app returns them as
    # origin-relative paths, so they must be routed here rather than falling
    # through to Next.
    location /media/ {
        proxy_pass http://rangon_api;
        expires 7d;
        access_log off;
    }

    # --- Web app -----------------------------------------------------------
    location /_next/static/ {
        proxy_pass http://rangon_web;
        expires 365d;
        access_log off;
        add_header Cache-Control "public, immutable";
    }

    location / {
        limit_req zone=general burst=60 nodelay;
        proxy_pass http://rangon_web;
        proxy_read_timeout 30s;
    }
}
