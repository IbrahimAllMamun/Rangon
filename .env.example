# ============================================================================
# Rangon Fashion — example environment file
# Copy to .env for local development.  NEVER commit a real .env.
# Production values must come from a secret manager, not from a file in git.
# ============================================================================

COMPOSE_PROJECT_NAME=rangon

# --- Django -----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,nginx
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=Asia/Dhaka

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=rangon
POSTGRES_USER=rangon
POSTGRES_PASSWORD=rangon_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rangon:rangon_dev_password@db:5432/rangon

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT --------------------------------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14

# --- Frontend ---------------------------------------------------------------
# Browser-visible API base (must be reachable from the user's browser)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Server-side API base used by Next.js server components inside Docker
API_INTERNAL_URL=http://api:8000/api/v1
# Host port for the storefront. Windows reserves wide TCP ranges (often
# including 3000); if `docker compose up` fails to bind, pick a free port:
#   netsh interface ipv4 show excludedportrange protocol=tcp
WEB_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=BDT
NEXT_PUBLIC_CURRENCY_SYMBOL=৳
NEXT_TELEMETRY_DISABLED=1

# --- Object storage (MinIO in dev, S3-compatible in prod) -------------------
USE_S3=0
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=rangon-media
S3_ACCESS_KEY=rangon_minio
S3_SECRET_KEY=rangon_minio_password
S3_REGION=us-east-1

# --- Email (Mailpit in dev) -------------------------------------------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=Rangon Fashion <no-reply@rangonfashion.test>

# --- Business configuration -------------------------------------------------
RANGON_CURRENCY=BDT
RANGON_ALLOW_OVERSELL=0
RANGON_RESERVATION_MINUTES=60
RANGON_LOW_STOCK_THRESHOLD=5
RANGON_DEFAULT_TAX_RATE=0.00

# --- Payment providers (placeholders; no real keys in git) ------------------
PAYMENT_DEFAULT_PROVIDER=manual
PAYMENT_SSLCOMMERZ_STORE_ID=
PAYMENT_SSLCOMMERZ_STORE_PASSWORD=
PAYMENT_BKASH_APP_KEY=
PAYMENT_BKASH_APP_SECRET=

# --- Courier providers (future integrations) --------------------------------
COURIER_DEFAULT_PROVIDER=manual
COURIER_PATHAO_CLIENT_ID=
COURIER_PATHAO_CLIENT_SECRET=

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
